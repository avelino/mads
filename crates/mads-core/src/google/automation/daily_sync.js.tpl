/**
 * daily-sync.js, generated by mads.
 *
 * Paste it into Google Ads > Tools > Bulk actions > Scripts, authorize it, then:
 *
 *   linkSheets()  run once after uploading the package folder to Drive (with "Convert uploads"
 *                 on). It points every daily and structural workbook at "0. Feed". Running it
 *                 again is safe.
 *   main()        schedule it daily, at night. It writes two tabs of "0. Feed":
 *                 "Account Status": every ad group of the automated campaigns and its status.
 *                   The feed compares it with what it wants and emits only the difference:
 *                   CREATE, PAUSE or ENABLE.
 *                 "Auto Negatives": the ad group negatives that stop one automated ad group
 *                   from taking the searches of another, recomputed from the feed every day.
 *   setupImageCampaigns()
 *                 run once after linkSheets, first with Preview, then for real. It creates
 *                 the paused Performance Max, Demand Gen and App campaigns of the "Image
 *                 Campaigns" tab, one atomic request each, with the pictures of the Images
 *                 subfolder. An existing campaign only gets its budget updated, a dropped one
 *                 is paused. The log has one line per campaign: created, budget updated,
 *                 paused, unchanged or FAILED <campaign>: <reason>.
 *
 * main() and linkSheets() only read the account. setupImageCampaigns() is the one function
 * that changes Google Ads, and only for the campaigns of "Image Campaigns".
 */

// ------------------------------------------------------------- generated
var FOLDER_NAME = __FOLDER_NAME__;
var AUTOMATED_CAMPAIGNS = __AUTOMATED_CAMPAIGNS__;
// [file path inside the folder without .xlsx, tab, range of "0. Feed" it mirrors]
var MIRRORS = __MIRRORS__;
// zero-based columns of the Feed tab
var FEED_COL = __FEED_COL__;
// zero-based columns of the Image Campaigns and Image Assets tabs
var IMAGE_CAMPAIGN_COL = __IMAGE_CAMPAIGN_COL__;
var IMAGE_ASSET_COL = __IMAGE_ASSET_COL__;

// ------------------------------------------------------------ do not edit
var FEED_FILE = '0. Feed';
var FEED_TAB = 'Feed';
var STATUS_TAB = 'Account Status';
var NEGATIVES_TAB = 'Auto Negatives';
var SUBFOLDERS = ['Daily', 'Structure'];
var FIRST_ROW = 5; // row 4 is the header on every tab
var STATUS_CAP = 1000;
var NEGATIVES_CAP = 2000;
var STATUS_COLS = 3;
var NEGATIVES_COLS = 5;
var SHEETS_MIME = 'application/vnd.google-apps.spreadsheet';


function main() {
  var feed = openFeed();
  var groups = writeAccountStatus(feed);
  var negatives = writeAutoNegatives(feed);
  Logger.log(STATUS_TAB + ': ' + groups + ' ad groups read from the account.');
  Logger.log(NEGATIVES_TAB + ': ' + negatives + ' negatives computed.');
  if (groups === 0) {
    Logger.log('No automated ad group in the account yet. Expected on the first day: ' +
               'the feed will ask to CREATE every group.');
  }
}


// ========================================================= account status
function writeAccountStatus(feed) {
  var sheet = requireSheet(feed, STATUS_TAB);
  var target = {};
  for (var i = 0; i < AUTOMATED_CAMPAIGNS.length; i++) target[AUTOMATED_CAMPAIGNS[i]] = true;

  var rows = [];
  var campaigns = AdsApp.campaigns().get(); // removed campaigns are left out by default
  while (campaigns.hasNext()) {
    var campaign = campaigns.next();
    var name = campaign.getName();
    if (!target[name]) continue;
    var groups = campaign.adGroups().get();
    while (groups.hasNext()) {
      var group = groups.next();
      if (group.isRemoved && group.isRemoved()) continue;
      rows.push([name, group.getName(), group.isEnabled() ? 'Enabled' : 'Paused']);
    }
  }

  return writeCapped(sheet, rows, STATUS_CAP, STATUS_COLS, 'F3', 'Last read: ',
                     'The account has ' + rows.length + ' ad groups in automated campaigns and ' +
                     'the "' + STATUS_TAB + '" block holds ' + STATUS_CAP + '. Split the ' +
                     'campaign or lower the catalog size, then run again: a half-read account ' +
                     'turns into CREATE for groups that already exist.');
}


// ========================================================= auto negatives
function writeAutoNegatives(feed) {
  var sheet = requireSheet(feed, NEGATIVES_TAB);
  var groups = feedGroups(requireSheet(feed, FEED_TAB));
  var out = isolationNegatives(groups);

  return writeCapped(sheet, out, NEGATIVES_CAP, NEGATIVES_COLS, 'G3', 'Last computed: ',
                     'The feed produced ' + out.length + ' negatives and the "' + NEGATIVES_TAB +
                     '" block holds ' + NEGATIVES_CAP + '. Remove overlapping keywords or ' +
                     'catalog items, then run again: a cut list loses part of the isolation ' +
                     'between ad groups.');
}

/**
 * Writes `rows` into the fixed block of `sheet` and stamps `stampCell`. Throws `overflow`
 * instead of writing a cut list when `rows` does not fit `cap`.
 */
function writeCapped(sheet, rows, cap, cols, stampCell, stampText, overflow) {
  if (rows.length > cap) throw new Error(overflow);
  writeBlock(sheet, rows, cap, cols);
  sheet.getRange(stampCell).setValue(stampText + now());
  return rows.length;
}

/**
 * Every ad group and keyword the feed keeps live, both tracks. Most negatives of an automated
 * group come from a fixed campaign keyword, so reading only automated rows would miss them.
 */
function feedGroups(sheet) {
  var data = readTab(sheet, FEED_COL);

  var groups = [], seen = {};
  for (var i = 0; i < data.length; i++) {
    var row = data[i];
    var action = String(row[FEED_COL.action]);
    if (action !== 'Add' && action !== 'Edit') continue;
    var campaign = String(row[FEED_COL.campaign] || '');
    var adGroup = String(row[FEED_COL.adGroup] || '');
    var keyword = String(row[FEED_COL.keyword] || '');
    if (!campaign || !adGroup || !keyword) continue;
    var key = campaign + '|' + adGroup + '|' + keyword;
    if (seen[key]) continue;
    seen[key] = true;
    groups.push({ campaign: campaign, adGroup: adGroup, keyword: keyword,
                  automated: String(row[FEED_COL.automated]) === 'Yes',
                  tokens: tokens(keyword) });
  }
  return groups;
}

/**
 * When A's keyword is a contiguous phrase inside B's keyword, B's search also triggers A, so
 * B's keyword becomes a Phrase negative in A's group. Only automated groups get negatives:
 * the fixed campaigns' negatives are structural and live in the Negatives tab.
 */
function isolationNegatives(groups) {
  var out = [], seen = {};
  for (var a = 0; a < groups.length; a++) {
    var ga = groups[a];
    if (!ga.automated) continue;
    for (var b = 0; b < groups.length; b++) {
      var gb = groups[b];
      if (ga.adGroup === gb.adGroup && ga.campaign === gb.campaign) continue;
      if (!containsPhrase(gb.tokens, ga.tokens)) continue;

      var reason = ga.campaign === gb.campaign
          ? 'Search belongs to ad group ' + gb.adGroup
          : 'Search belongs to campaign ' + gb.campaign;

      // a negative does not match the accented spelling of a search: emit both
      var spellings = [gb.keyword];
      var plain = stripAccents(gb.keyword);
      if (plain !== gb.keyword) spellings.push(plain);

      for (var v = 0; v < spellings.length; v++) {
        var key = ga.campaign + '|' + ga.adGroup + '|' + spellings[v];
        if (seen[key]) continue;
        seen[key] = true;
        out.push([ga.campaign, ga.adGroup, spellings[v], 'Phrase', reason]);
      }
    }
  }
  out.sort(function (x, y) {
    var kx = x[0] + '|' + x[1] + '|' + x[2];
    var ky = y[0] + '|' + y[1] + '|' + y[2];
    return kx < ky ? -1 : (kx > ky ? 1 : 0);
  });
  return out;
}


// ================================================================ helpers
/** `small` is a contiguous run of `big`, and shorter. */
function containsPhrase(big, small) {
  if (small.length >= big.length) return false;
  for (var i = 0; i + small.length <= big.length; i++) {
    var same = true;
    for (var j = 0; j < small.length; j++) {
      if (big[i + j] !== small[j]) { same = false; break; }
    }
    if (same) return true;
  }
  return false;
}

function tokens(keyword) {
  var parts = stripAccents(String(keyword).toLowerCase()).split(/\s+/);
  var out = [];
  for (var i = 0; i < parts.length; i++) {
    if (parts[i].length > 0) out.push(parts[i]);
  }
  return out;
}

var ACCENTS = {
  'á': 'a', 'à': 'a', 'ã': 'a', 'â': 'a', 'ä': 'a',
  'é': 'e', 'ê': 'e', 'è': 'e', 'ë': 'e',
  'í': 'i', 'ì': 'i', 'î': 'i', 'ï': 'i',
  'ó': 'o', 'õ': 'o', 'ô': 'o', 'ò': 'o', 'ö': 'o',
  'ú': 'u', 'ù': 'u', 'û': 'u', 'ü': 'u',
  'ç': 'c', 'ñ': 'n'
};

function stripAccents(s) {
  var out = '';
  var text = String(s);
  for (var i = 0; i < text.length; i++) {
    var c = text.charAt(i);
    var lower = c.toLowerCase();
    if (ACCENTS[lower]) {
      out += c === lower ? ACCENTS[lower] : ACCENTS[lower].toUpperCase();
    } else {
      out += c;
    }
  }
  return out;
}

/** Same form Rust uses for campaign names: NFC, lowercase, trim, collapse whitespace. */
function normalizeName(s) {
  var nfc = String(s).normalize ? String(s).normalize('NFC') : String(s);
  return nfc.toLowerCase().split(/\s+/).filter(function(p) { return p.length > 0; }).join(' ');
}

function requireSheet(spreadsheet, name) {
  var sheet = spreadsheet.getSheetByName(name);
  if (!sheet) {
    throw new Error('Tab "' + name + '" not found in "' + FEED_FILE + '". Upload the package ' +
                    'again or restore the tab.');
  }
  return sheet;
}

/** Clears the whole block, then writes `rows` from FIRST_ROW. */
function writeBlock(sheet, rows, capacity, cols) {
  growGrid(sheet, FIRST_ROW + capacity - 1, cols);
  sheet.getRange(FIRST_ROW, 1, capacity, cols).clearContent();
  if (rows.length > 0) sheet.getRange(FIRST_ROW, 1, rows.length, cols).setValues(rows);
}

/** getRange fails out of bounds, and a new Sheets tab starts with 1000 rows. */
function growGrid(sheet, lastRow, lastCol) {
  if (sheet.getMaxRows() < lastRow) {
    sheet.insertRowsAfter(sheet.getMaxRows(), lastRow - sheet.getMaxRows());
  }
  if (sheet.getMaxColumns() < lastCol) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), lastCol - sheet.getMaxColumns());
  }
}

function now() {
  return Utilities.formatDate(new Date(), AdsApp.currentAccount().getTimeZone(),
                              'yyyy-MM-dd HH:mm');
}


// ================================================================== drive
function packageFolder() {
  var it = DriveApp.getFoldersByName(FOLDER_NAME);
  var found = [];
  while (it.hasNext()) found.push(it.next());
  if (found.length === 0) {
    throw new Error('Folder "' + FOLDER_NAME + '" not found in Drive. Upload the package ' +
                    'folder without renaming it, or set FOLDER_NAME to its name.');
  }
  if (found.length > 1) {
    throw new Error('Found ' + found.length + ' folders named "' + FOLDER_NAME + '". Rename or ' +
                    'delete the extra ones so the script reads the right package.');
  }
  return found[0];
}

/** The package folder, then its Daily and Structure subfolders. */
function searchFolders(root) {
  var folders = [root];
  for (var i = 0; i < SUBFOLDERS.length; i++) {
    var it = root.getFoldersByName(SUBFOLDERS[i]);
    while (it.hasNext()) folders.push(it.next());
  }
  return folders;
}

/**
 * Id of the Google Sheet called `name` (a converted upload keeps or drops the .xlsx suffix).
 * An unconverted .xlsx cannot be opened by SpreadsheetApp, so it is reported, not used.
 */
function findSheetId(folders, name) {
  var names = [name, name + '.xlsx'];
  var unconverted = false;
  for (var f = 0; f < folders.length; f++) {
    for (var n = 0; n < names.length; n++) {
      var it = folders[f].getFilesByName(names[n]);
      while (it.hasNext()) {
        var file = it.next();
        if (file.getMimeType() === SHEETS_MIME) return file.getId();
        unconverted = true;
      }
    }
  }
  if (unconverted) {
    throw new Error('"' + name + '" is an .xlsx file, not a Google Sheet. Upload it again with ' +
                    '"Convert uploads" on in Drive settings.');
  }
  throw new Error('"' + name + '" not found in "' + FOLDER_NAME + '" or its ' +
                  SUBFOLDERS.join('/') + ' subfolders.');
}

function openFeed() {
  var id = findSheetId(searchFolders(packageFolder()), FEED_FILE);
  return SpreadsheetApp.openById(id);
}

function baseName(path) {
  var parts = String(path).split('/');
  return parts[parts.length - 1];
}


// ============================================================ linkSheets
/**
 * Points each mirror tab of the daily and structural workbooks at "0. Feed" with IMPORTRANGE.
 * Safe to run again. After it, open each workbook once and click "Allow access" on the #REF!
 * cell: Google requires a person for that and offers no API.
 */
function linkSheets() {
  var folders = searchFolders(packageFolder());
  var feedId = findSheetId(folders, FEED_FILE);
  var feed = SpreadsheetApp.openById(feedId);
  growGrid(requireSheet(feed, STATUS_TAB), FIRST_ROW + STATUS_CAP - 1, STATUS_COLS);
  growGrid(requireSheet(feed, NEGATIVES_TAB), FIRST_ROW + NEGATIVES_CAP - 1, NEGATIVES_COLS);

  var linked = 0, failed = 0;
  for (var i = 0; i < MIRRORS.length; i++) {
    var file = MIRRORS[i][0], tab = MIRRORS[i][1], range = MIRRORS[i][2];
    try {
      var target = SpreadsheetApp.openById(findSheetId(folders, baseName(file)));
      linkTab(target, tab, range, feedId);
      Logger.log('linked ' + file + ' (' + tab + ')');
      linked++;
    } catch (e) {
      Logger.log('FAILED ' + file + ': ' + errorText(e));
      failed++;
    }
  }
  Logger.log('Linked ' + linked + ' of ' + MIRRORS.length + ' mirror tabs, ' + failed +
             ' failed. Open each workbook and click "Allow access" on the #REF! cell.');
}

/** Clears the frozen copy and writes the IMPORTRANGE formula on its first cell. */
function linkTab(spreadsheet, tab, range, feedId) {
  var sheet = spreadsheet.getSheetByName(tab);
  if (!sheet) throw new Error('tab "' + tab + '" not found');

  // IMPORTRANGE returns a whole block and shows #REF! when the grid is too small for it
  var size = rangeSize(range);
  growGrid(sheet, FIRST_ROW + size.rows - 1, size.cols);

  var last = Math.max(sheet.getLastRow(), FIRST_ROW);
  var cols = Math.max(size.cols, sheet.getLastColumn());
  sheet.getRange(FIRST_ROW, 1, last - FIRST_ROW + 1, cols).clearContent();

  // setFormula always takes English syntax; Sheets converts the separator for the locale
  sheet.getRange(FIRST_ROW, 1).setFormula('=IMPORTRANGE("' + feedId + '","' + range + '")');
}

/** Rows and columns a range like "Feed!A5:AM156" returns. */
function rangeSize(range) {
  var m = String(range).match(/([A-Z]+)(\d+):([A-Z]+)(\d+)$/);
  if (!m) throw new Error('cannot read range "' + range + '"');
  return { rows: Number(m[4]) - Number(m[2]) + 1, cols: columnNumber(m[3]) };
}

function columnNumber(letters) {
  var n = 0;
  for (var i = 0; i < letters.length; i++) n = n * 26 + (letters.charCodeAt(i) - 64);
  return n;
}


// ===================================================== setupImageCampaigns
//
// Creates the Performance Max, Demand Gen and App campaigns of "Image Campaigns" through
// AdsApp.mutateAll, one atomic request per campaign, with the pictures read from the Images
// subfolder. Payloads follow the Google Ads API REST JSON shape, as scripts' mutate takes it:
// https://developers.google.com/google-ads/scripts/docs/features/mutate
var IMAGE_CAMPAIGNS_TAB = 'Image Campaigns';
var IMAGE_ASSETS_TAB = 'Image Assets';
var IMAGES_FOLDER = 'Images';
var EU_POLITICAL = 'DOES_NOT_CONTAIN_EU_POLITICAL_ADVERTISING';
var CAMPAIGN_QUERY = 'SELECT campaign.id, campaign.name, campaign.status, ' +
    'campaign.resource_name, campaign_budget.resource_name, campaign_budget.amount_micros ' +
    'FROM campaign WHERE campaign.status != REMOVED';
// Field types an asset group takes as AssetGroupAsset. BUSINESS_NAME and LOGO go to the
// campaign: brand guidelines are on.
// https://developers.google.com/google-ads/api/performance-max/asset-requirements
var PMAX_GROUP_FIELDS = ['HEADLINE', 'LONG_HEADLINE', 'DESCRIPTION', 'MARKETING_IMAGE',
                         'SQUARE_MARKETING_IMAGE', 'PORTRAIT_MARKETING_IMAGE'];
// DemandGenMultiAssetAdInfo: list field per feed field, and its maximum size.
// https://developers.google.com/google-ads/api/reference/rpc/latest/DemandGenMultiAssetAdInfo
var DEMAND_GEN_IMAGES = {
  MARKETING_IMAGE: 'marketingImages',
  SQUARE_MARKETING_IMAGE: 'squareMarketingImages',
  PORTRAIT_MARKETING_IMAGE: 'portraitMarketingImages',
  TALL_PORTRAIT_MARKETING_IMAGE: 'tallPortraitMarketingImages',
  LOGO: 'logoImages'
};
var DEMAND_GEN_MAX = { headlines: 5, descriptions: 5, logoImages: 5 };
var APP_IMAGE_FIELDS = ['MARKETING_IMAGE', 'SQUARE_MARKETING_IMAGE', 'PORTRAIT_MARKETING_IMAGE',
                        'TALL_PORTRAIT_MARKETING_IMAGE'];
var APP_STORES = { 'Google Play': 'GOOGLE_APP_STORE', 'Apple App Store': 'APPLE_APP_STORE' };

function setupImageCampaigns() {
  var root = packageFolder();
  var feed = SpreadsheetApp.openById(findSheetId(searchFolders(root), FEED_FILE));
  var rows = readImageCampaigns(requireSheet(feed, IMAGE_CAMPAIGNS_TAB));
  var assets = readImageAssets(requireSheet(feed, IMAGE_ASSETS_TAB));
  var live = liveCampaigns();
  var env = { customerId: customerId(), images: imagesFolder(root), targets: {} };

  var counts = { created: 0, 'budget updated': 0, paused: 0, unchanged: 0, FAILED: 0 };
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    try {
      var outcome = syncImageCampaign(row, assets[row.key] || [], live[normalizeName(row.name)], env);
      Logger.log(outcome + ' ' + row.name);
      counts[outcome]++;
    } catch (e) {
      Logger.log('FAILED ' + row.name + ': ' + errorText(e));
      counts.FAILED++;
    }
  }
  Logger.log('Image campaigns: ' + counts.created + ' created, ' + counts['budget updated'] +
             ' budget updated, ' + counts.paused + ' paused, ' + counts.unchanged +
             ' unchanged, ' + counts.FAILED + ' failed.');
}

/** One of: created, budget updated, paused, unchanged. Throws on failure. */
function syncImageCampaign(row, assets, live, env) {
  if (row.action === 'Pause') {
    if (!live || live.status !== 'ENABLED') return 'unchanged';
    mutateOne({ campaignOperation: {
      update: { resourceName: live.resourceName, status: 'PAUSED' }, updateMask: 'status' } });
    return 'paused';
  }
  if (row.action !== 'Add' && row.action !== 'Edit') return 'unchanged';
  if (live) {
    var micros = toMicros(row.budget, 'Budget');
    if (Number(live.budgetMicros) === Number(micros)) return 'unchanged';
    // https://developers.google.com/google-ads/scripts/docs/features/mutate (update + updateMask)
    mutateOne({ campaignBudgetOperation: {
      update: { resourceName: live.budgetResourceName, amountMicros: micros },
      updateMask: 'amount_micros' } });
    return 'budget updated';
  }
  var ops = campaignOperations(row, assets, env);
  checkResults(AdsApp.mutateAll(ops, { partialFailure: false }));
  return 'created';
}

function campaignOperations(row, assets, env) {
  var b = newBuild(row, env);
  var builders = {
    'Performance Max': buildPerformanceMax,
    'Demand Gen': buildDemandGen,
    'App': buildApp
  };
  var build = builders[row.type];
  if (!build) throw new Error('unknown campaign type "' + row.type + '"');
  build(b, row, groupAssets(assets));
  // assets first: an operation may only refer to a resource created before it
  return [b.budgetOp, b.campaignOp].concat(b.assetOps, b.ops);
}


// --------------------------------------------------------- feed reading
function readImageCampaigns(sheet) {
  var c = IMAGE_CAMPAIGN_COL;
  return readTab(sheet, c).map(function (r) {
    return {
      key: cell(r, c.key), name: cell(r, c.campaign), type: cell(r, c.campaignType),
      budget: cell(r, c.budget), bid: cell(r, c.bidStrategy), maxCpc: cell(r, c.maxCpc),
      language: cell(r, c.language), location: cell(r, c.location),
      finalUrl: cell(r, c.finalUrl), businessName: cell(r, c.businessName),
      appId: cell(r, c.appId), appStore: cell(r, c.appStore), action: cell(r, c.action)
    };
  }).filter(function (r) { return r.name !== ''; });
}

/** Asset rows by campaign key, in feed order. */
function readImageAssets(sheet) {
  var c = IMAGE_ASSET_COL;
  var out = {};
  readTab(sheet, c).forEach(function (r) {
    var key = cell(r, c.key);
    if (!key) return;
    (out[key] = out[key] || []).push({ group: cell(r, c.group), field: cell(r, c.field),
                                       text: cell(r, c.text), file: cell(r, c.imageFile) });
  });
  return out;
}

function readTab(sheet, cols) {
  var last = sheet.getLastRow();
  if (last < FIRST_ROW) return [];
  var width = 0;
  for (var k in cols) width = Math.max(width, cols[k] + 1);
  return sheet.getRange(FIRST_ROW, 1, last - FIRST_ROW + 1, width).getValues();
}

function cell(row, col) {
  var v = row[col];
  return v === null || v === undefined ? '' : String(v).trim();
}

/** [{name, assets}] in feed order. */
function groupAssets(assets) {
  var groups = [], byName = {};
  for (var i = 0; i < assets.length; i++) {
    var name = assets[i].group;
    if (!byName[name]) {
      byName[name] = { name: name, assets: [] };
      groups.push(byName[name]);
    }
    byName[name].assets.push(assets[i]);
  }
  return groups;
}


// -------------------------------------------------------------- account
/** Campaigns of the account by name, removed ones left out. */
function liveCampaigns() {
  var out = {};
  var rows = AdsApp.search(CAMPAIGN_QUERY);
  while (rows.hasNext()) {
    var r = rows.next();
    out[normalizeName(r.campaign.name)] = {
      status: r.campaign.status,
      resourceName: r.campaign.resourceName ||
          'customers/' + customerId() + '/campaigns/' + r.campaign.id,
      budgetResourceName: r.campaignBudget.resourceName,
      budgetMicros: r.campaignBudget.amountMicros
    };
  }
  return out;
}

function customerId() {
  return String(AdsApp.currentAccount().getCustomerId()).replace(/\D/g, '');
}

function mutateOne(op) {
  checkResults([AdsApp.mutate(op)]);
}

function checkResults(results) {
  var errors = [];
  for (var i = 0; i < results.length; i++) {
    if (!results[i].isSuccessful()) errors = errors.concat(results[i].getErrorMessages());
  }
  if (errors.length > 0) throw new Error(unique(errors).join('; '));
  if (results.length === 0) throw new Error('the API returned no result');
}

function errorText(e) {
  return e && e.message ? e.message : String(e);
}

function unique(values) {
  var seen = {}, out = [];
  for (var i = 0; i < values.length; i++) {
    if (seen[values[i]]) continue;
    seen[values[i]] = true;
    out.push(values[i]);
  }
  return out;
}

/** "40.00" (or 40, or "40,00") in micros, as the int64 string the API takes. */
function toMicros(value, label) {
  var n = Number(String(value).replace(',', '.'));
  if (String(value) === '' || !isFinite(n) || n <= 0) {
    throw new Error(label + ' "' + value + '" is not a positive amount');
  }
  return String(Math.round(n * 1000000));
}


// -------------------------------------------------------------- targets
/** languageConstants/... for an ISO code such as "pt", or null. */
function languageConstant(env, code) {
  var key = 'lang|' + code;
  if (!(key in env.targets)) {
    var rows = searchAll('SELECT language_constant.resource_name FROM language_constant ' +
                         'WHERE language_constant.code = ' + gaqlString(code));
    env.targets[key] = rows.length === 1 ? rows[0].languageConstant.resourceName : null;
  }
  return env.targets[key];
}

/**
 * geoTargetConstants/... for a place name ("Brazil") or canonical name ("Sao Paulo,Brazil"),
 * or null when nothing or more than one place matches.
 */
function geoTargetConstant(env, place) {
  var key = 'geo|' + place;
  if (!(key in env.targets)) {
    var field = place.indexOf(',') >= 0 ? 'canonical_name' : 'name';
    var rows = searchAll('SELECT geo_target_constant.resource_name, ' +
                         'geo_target_constant.target_type FROM geo_target_constant WHERE ' +
                         'geo_target_constant.' + field + ' = ' + gaqlString(place) +
                         " AND geo_target_constant.status = 'ENABLED'");
    var countries = rows.filter(function (r) {
      return r.geoTargetConstant.targetType === 'Country';
    });
    var pick = rows.length === 1 ? rows : countries;
    env.targets[key] = pick.length === 1 ? pick[0].geoTargetConstant.resourceName : null;
  }
  return env.targets[key];
}

function searchAll(query) {
  var out = [];
  var it = AdsApp.search(query);
  while (it.hasNext()) out.push(it.next());
  return out;
}

function gaqlString(s) {
  return "'" + String(s).replace(/\\/g, '\\\\').replace(/'/g, "\\'") + "'";
}

/** [{language}, {location}] criterion bodies the row asks for and the account resolves. */
function targetCriteria(b, row) {
  var out = [];
  if (row.language) {
    var lang = languageConstant(b.env, row.language);
    if (lang) out.push({ language: { languageConstant: lang } });
    else warn(b, 'language "' + row.language + '" not found, campaign targets all languages');
  }
  if (row.location) {
    var geo = geoTargetConstant(b.env, row.location);
    if (geo) out.push({ location: { geoTargetConstant: geo } });
    else warn(b, 'location "' + row.location + '" not found or ambiguous, campaign targets ' +
                 'every location. Set it in Google Ads before enabling the campaign.');
  }
  return out;
}

function warn(b, message) {
  Logger.log('WARNING ' + b.row.name + ': ' + message);
}


// ------------------------------------------------------------- building
/** The operations of one campaign under construction, with its temporary ids. */
function newBuild(row, env) {
  var b = { row: row, env: env, nextId: -1, assetOps: [], ops: [], texts: {}, images: {} };
  b.budget = tempName(b, 'campaignBudgets');
  b.campaign = tempName(b, 'campaigns');
  b.budgetOp = budgetOperation(b);
  return b;
}

/** customers/<id>/<collection>/<negative temporary id> */
function tempName(b, collection) {
  var name = 'customers/' + b.env.customerId + '/' + collection + '/' + b.nextId;
  b.nextId--;
  return name;
}

// Budget: daily, standard delivery, never shared (Performance Max, Demand Gen and App all
// refuse a shared one). The name carries the time: budget names are unique per account and a
// removed campaign keeps its budget.
// https://developers.google.com/google-ads/scripts/docs/campaigns/performance-max/required-components
// https://developers.google.com/google-ads/api/performance-max/create-budget
function budgetOperation(b) {
  return { campaignBudgetOperation: { create: {
    resourceName: b.budget,
    name: b.row.name + ' budget ' + now(),
    amountMicros: toMicros(b.row.budget, 'Budget'),
    deliveryMethod: 'STANDARD',
    explicitlyShared: false
  } } };
}

/** The campaign create body every type shares. */
function campaignBase(b, channel) {
  return {
    resourceName: b.campaign,
    name: b.row.name,
    status: 'PAUSED',
    advertisingChannelType: channel,
    campaignBudget: b.budget,
    containsEuPoliticalAdvertising: EU_POLITICAL
  };
}

function textAsset(b, text) {
  if (!b.texts[text]) {
    b.texts[text] = tempName(b, 'assets');
    b.assetOps.push({ assetOperation: { create: {
      resourceName: b.texts[text], textAsset: { text: text } } } });
  }
  return b.texts[text];
}

// Image asset from Drive, base64 of the file's bytes.
// https://developers.google.com/google-ads/scripts/docs/campaigns/performance-max/assets
function imageAsset(b, path) {
  if (!b.images[path]) {
    var file = picture(b.env.images, path);
    b.images[path] = tempName(b, 'assets');
    b.assetOps.push({ assetOperation: { create: {
      resourceName: b.images[path],
      name: b.row.name + ' - ' + path,
      type: 'IMAGE',
      imageAsset: { data: Utilities.base64Encode(file.getBlob().getBytes()) }
    } } });
  }
  return b.images[path];
}

/** The Images subfolder of the package, or null. */
function imagesFolder(root) {
  var it = root.getFoldersByName(IMAGES_FOLDER);
  return it.hasNext() ? it.next() : null;
}

/** The Drive file at `path` inside Images/ ("<campaign_key>/<file>" or "logo.png"). */
function picture(images, path) {
  var missing = 'picture "' + IMAGES_FOLDER + '/' + path + '" not found in "' + FOLDER_NAME +
                '". Upload it or fix "Image file" in "' + IMAGE_ASSETS_TAB + '".';
  if (!images || !path) throw new Error(missing);
  var parts = String(path).split('/');
  var folder = images;
  for (var i = 0; i < parts.length - 1; i++) {
    var sub = folder.getFoldersByName(parts[i]);
    if (!sub.hasNext()) throw new Error(missing);
    folder = sub.next();
  }
  var files = folder.getFilesByName(parts[parts.length - 1]);
  if (!files.hasNext()) throw new Error(missing);
  return files.next();
}

function fieldValues(assets, field) {
  return unique(assets
    .filter(function (a) { return a.field === field; })
    .map(function (a) { return a.text || a.file; })
    .filter(Boolean));
}

/** Fields of `assets` the builder does not place, logged once per campaign. */
function warnUnused(b, assets, used) {
  var skipped = unique(assets
    .map(function (a) { return a.field; })
    .filter(function (f) { return used.indexOf(f) < 0; }));
  if (skipped.length > 0) warn(b, b.row.type + ' does not take ' + skipped.join(', ') + ', skipped');
}


// ------------------------------------------------------------- bidding
// Performance Max takes only Maximize conversions (or conversion value), and App installs
// without a target install cost take Maximize conversions too. Every other mads strategy maps
// to it. `subject` names the campaign type in the warning.
// https://developers.google.com/google-ads/api/performance-max/create-campaign
// https://developers.google.com/google-ads/api/docs/app-campaigns/create-campaign
function maximizeConversionsBidding(b, subject) {
  if (b.row.bid !== 'maximize_conversions') {
    warn(b, subject + ' ' + (b.row.bid || 'an empty bid strategy') +
            ', using maximize conversions');
  }
  return { maximizeConversions: {} };
}

// Demand Gen takes Maximize clicks (TargetSpend), Target CPA, Maximize conversions and Target
// ROAS, with no Max CPC ceiling. Manual CPC maps to Maximize clicks.
// https://developers.google.com/google-ads/api/docs/demand-gen/create-campaign
// https://developers.google.com/google-ads/api/docs/campaigns/bidding/strategy-types
function demandGenBidding(b) {
  if (b.row.bid === 'maximize_conversions') return { maximizeConversions: {} };
  if (b.row.bid !== 'maximize_clicks') {
    warn(b, 'Demand Gen does not take ' + (b.row.bid || 'an empty bid strategy') +
            ', using maximize clicks');
  }
  if (b.row.maxCpc) {
    warn(b, 'Demand Gen maximize clicks has no Max CPC ceiling, ' + b.row.maxCpc + ' ignored');
  }
  return { targetSpend: {} };
}


function assign(target, source) {
  for (var k in source) target[k] = source[k];
  return target;
}


// ------------------------------------------------------- performance max
// Campaign, criteria, brand assets on the campaign, then per asset group: the group, its
// AssetGroupAssets and its search themes, all in one request.
// https://developers.google.com/google-ads/scripts/docs/campaigns/performance-max/required-components
// https://developers.google.com/google-ads/api/performance-max/create-campaign (brand guidelines)
// https://developers.google.com/google-ads/api/performance-max/create-campaign-criteria
// https://developers.google.com/google-ads/api/performance-max/asset-group-signals
function buildPerformanceMax(b, row, groups) {
  var campaign = assign(campaignBase(b, 'PERFORMANCE_MAX'),
                        maximizeConversionsBidding(b, 'Performance Max does not take'));
  campaign.brandGuidelinesEnabled = true;
  b.campaignOp = { campaignOperation: { create: campaign } };
  pushCampaignCriteria(b, row);
  pushBrandAssets(b, row, groups);
  for (var i = 0; i < groups.length; i++) pushAssetGroup(b, row, groups[i]);
}

function pushCampaignCriteria(b, row) {
  var criteria = targetCriteria(b, row);
  for (var i = 0; i < criteria.length; i++) {
    b.ops.push({ campaignCriterionOperation: {
      create: assign({ campaign: b.campaign }, criteria[i]) } });
  }
}

/** Exactly one BUSINESS_NAME and one to five LOGOs, linked to the campaign. */
function pushBrandAssets(b, row, groups) {
  var all = [];
  for (var i = 0; i < groups.length; i++) all = all.concat(groups[i].assets);
  var name = fieldValues(all, 'BUSINESS_NAME')[0] || row.businessName;
  if (!name) throw new Error('no business name: fill "Business name" or a BUSINESS_NAME row');
  var logos = fieldValues(all, 'LOGO').slice(0, 5);
  if (logos.length === 0) throw new Error('no LOGO row in "' + IMAGE_ASSETS_TAB + '"');
  pushCampaignAsset(b, textAsset(b, name), 'BUSINESS_NAME');
  for (var j = 0; j < logos.length; j++) pushCampaignAsset(b, imageAsset(b, logos[j]), 'LOGO');
}

function pushCampaignAsset(b, asset, fieldType) {
  b.ops.push({ campaignAssetOperation: { create: {
    campaign: b.campaign, asset: asset, fieldType: fieldType } } });
}

function pushAssetGroup(b, row, group) {
  var name = tempName(b, 'assetGroups');
  b.ops.push({ assetGroupOperation: { create: {
    resourceName: name, campaign: b.campaign, name: group.name,
    finalUrls: [row.finalUrl], status: 'ENABLED' } } });
  for (var i = 0; i < group.assets.length; i++) {
    var a = group.assets[i];
    if (PMAX_GROUP_FIELDS.indexOf(a.field) < 0) continue;
    var asset = a.file ? imageAsset(b, a.file) : textAsset(b, a.text);
    b.ops.push({ assetGroupAssetOperation: { create: {
      assetGroup: name, asset: asset, fieldType: a.field } } });
  }
  var themes = fieldValues(group.assets, 'SEARCH_THEME');
  for (var j = 0; j < themes.length; j++) {
    b.ops.push({ assetGroupSignalOperation: { create: {
      assetGroup: name, searchTheme: { text: themes[j] } } } });
  }
  warnUnused(b, group.assets, PMAX_GROUP_FIELDS.concat(['SEARCH_THEME', 'BUSINESS_NAME', 'LOGO']));
}


// ------------------------------------------------------------ demand gen
// Campaign without sub type, ad group without type (language and location target the ad
// group), one DemandGenMultiAssetAd per ad group. businessName is a plain string there.
// https://developers.google.com/google-ads/scripts/docs/campaigns/demand-gen/required-components
// https://developers.google.com/google-ads/api/docs/demand-gen/create-campaign
// https://developers.google.com/google-ads/api/docs/demand-gen/overview (AdGroupCriterion)
// https://developers.google.com/google-ads/api/reference/rpc/latest/DemandGenMultiAssetAdInfo
function buildDemandGen(b, row, groups) {
  b.campaignOp = { campaignOperation: { create: assign(campaignBase(b, 'DEMAND_GEN'),
                                                       demandGenBidding(b)) } };
  var criteria = targetCriteria(b, row);
  for (var i = 0; i < groups.length; i++) {
    var adGroup = pushAdGroup(b, groups[i]);
    for (var j = 0; j < criteria.length; j++) {
      b.ops.push({ adGroupCriterionOperation: {
        create: assign({ adGroup: adGroup }, criteria[j]) } });
    }
    pushAd(b, row, adGroup, { demandGenMultiAssetAd: demandGenAd(b, row, groups[i].assets) });
  }
}

function demandGenAd(b, row, assets) {
  var ad = {
    headlines: texts(b, assets, 'HEADLINE', DEMAND_GEN_MAX.headlines),
    descriptions: texts(b, assets, 'DESCRIPTION', DEMAND_GEN_MAX.descriptions),
    businessName: fieldValues(assets, 'BUSINESS_NAME')[0] || row.businessName
  };
  for (var field in DEMAND_GEN_IMAGES) {
    var list = DEMAND_GEN_IMAGES[field];
    var files = fieldValues(assets, field).slice(0, DEMAND_GEN_MAX[list] || 20);
    if (files.length === 0) continue;
    ad[list] = files.map(function (f) { return { asset: imageAsset(b, f) }; });
  }
  warnUnused(b, assets, ['HEADLINE', 'DESCRIPTION', 'BUSINESS_NAME'].concat(
      Object.keys(DEMAND_GEN_IMAGES)));
  return ad;
}

/** AdTextAsset list: text inline, as the API allows for ad text. */
function texts(b, assets, field, max) {
  var values = fieldValues(assets, field);
  if (values.length > max) {
    warn(b, 'keeping the first ' + max + ' of ' + values.length + ' ' + field + ' rows');
  }
  return values.slice(0, max).map(function (t) { return { text: t }; });
}

function pushAdGroup(b, group) {
  var name = tempName(b, 'adGroups');
  b.ops.push({ adGroupOperation: { create: {
    resourceName: name, campaign: b.campaign, name: group.name, status: 'ENABLED' } } });
  return name;
}

function pushAd(b, row, adGroup, info) {
  var ad = assign({ name: b.row.name + ' ad' }, info);
  if (row.finalUrl) ad.finalUrls = [row.finalUrl];
  b.ops.push({ adGroupAdOperation: { create: {
    adGroup: adGroup, status: 'ENABLED', ad: ad } } });
}


// ------------------------------------------------------------------- app
// MULTI_CHANNEL + APP_CAMPAIGN, app id and store in appCampaignSetting, installs without a
// target cost. Language and location target the campaign. One AppAdInfo per ad group, text
// inline, images as assets.
// https://developers.google.com/google-ads/api/docs/app-campaigns/create-campaign
// https://developers.google.com/google-ads/api/docs/app-campaigns/create-ad-group
// https://developers.google.com/google-ads/api/reference/rpc/latest/AppAdInfo
function buildApp(b, row, groups) {
  if (!row.appId) throw new Error('no App ID: set google_ads.app_id or [app] and export again');
  var store = APP_STORES[row.appStore];
  if (!store) throw new Error('App store "' + row.appStore + '" is not Google Play or Apple App Store');
  var campaign = assign(campaignBase(b, 'MULTI_CHANNEL'),
                        maximizeConversionsBidding(b, 'App campaigns do not take'));
  campaign.advertisingChannelSubType = 'APP_CAMPAIGN';
  campaign.appCampaignSetting = {
    appId: row.appId,
    appStore: store,
    biddingStrategyGoalType: 'OPTIMIZE_INSTALLS_WITHOUT_TARGET_INSTALL_COST'
  };
  b.campaignOp = { campaignOperation: { create: campaign } };
  pushCampaignCriteria(b, row);
  for (var i = 0; i < groups.length; i++) {
    var assets = groups[i].assets;
    var adGroup = pushAdGroup(b, groups[i]);
    var images = [];
    for (var j = 0; j < APP_IMAGE_FIELDS.length; j++) {
      images = images.concat(fieldValues(assets, APP_IMAGE_FIELDS[j]));
    }
    var app = { headlines: texts(b, assets, 'HEADLINE', 5),
                descriptions: texts(b, assets, 'DESCRIPTION', 5) };
    if (images.length > 0) app.images = images.map(function (f) { return { asset: imageAsset(b, f) }; });
    warnUnused(b, assets, ['HEADLINE', 'DESCRIPTION'].concat(APP_IMAGE_FIELDS));
    pushAd(b, {}, adGroup, { appAd: app });
  }
}
